---
import '../styles/global.css';
import '../styles/reytingi.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { u, abs } from '../lib/url';
import { NOINDEX_ALL, SITE_NAME } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** noindex страницы по карте сайта (спасибо, 404, карта сайта, хаб с одной нишей) */
  noindex?: boolean;
  /** Путь страницы без base, со слэшем: /metodika/ */
  path: string;
  active?: string;
  /** JSON-LD (@graph) – собирается из тех же данных, что видимый текст */
  ld?: object | null;
  srezLine?: boolean;
  /** Не ставить canonical (404) */
  noCanonical?: boolean;
  bodyClass?: string;
}
const { title, description = '', noindex = false, path, active, ld = null, srezLine = false, noCanonical = false, bodyClass = '' } = Astro.props;
const canonical = abs(path, Astro.site);
// Тестовый показ на Pages закрыт целиком; иначе – по карте сайта (noindex, follow).
const robots = NOINDEX_ALL ? 'noindex, nofollow' : noindex ? 'noindex, follow' : '';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!noCanonical && <link rel="canonical" href={canonical} />}
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content="ru_RU" />
    {!noCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={abs('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" content="#f4ece0" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={u('/fonts/golos-text-normal-cyrillic.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={u('/fonts/literata-normal-cyrillic.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={u('/fonts/fonts.css')} />
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body class={bodyClass || undefined}>
    <a class="sr-only" href="#main">К содержимому</a>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer srezLine={srezLine} />
    <slot name="after" />
  </body>
</html>
