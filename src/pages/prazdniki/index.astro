---
// Хаб «Праздники» – тексты из teksty-nsk.md (раздел 2). noindex, follow до второй ниши (карта сайта). Без таблицы компаний.
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { COMPANIES, NICHE } from '../../lib/niche';
import { u, abs } from '../../lib/url';
import { dec } from '../../lib/fmt';
import { SITE_NAME, SREZ, hubIndexable } from '../../lib/site';
import { org, orgId, crumbs, graph } from '../../lib/ld';

const site = Astro.site;
const c1 = COMPANIES[0];
const ld = graph(
  org(site),
  {
    '@type': 'CollectionPage', url: abs('/prazdniki/', site), name: 'Праздники: рейтинги Новосибирска', inLanguage: 'ru', publisher: { '@id': orgId(site) },
    mainEntity: { '@type': 'ItemList', itemListElement: [{ '@type': 'ListItem', position: 1, item: { '@type': 'WebPage', '@id': abs(NICHE.path, site), name: 'Доставка цветов', url: abs(NICHE.path, site) } }] },
  },
  crumbs([{ name: 'Главная', path: '/' }, { name: 'Праздники', path: '/prazdniki/' }], site),
);
---
<Base
  title={`Праздники в Новосибирске – рейтинги компаний | ${SITE_NAME}`}
  description={`Рейтинги по разделу «Праздники» в Новосибирске: доставка цветов. Открытая формула, данные на ${SREZ}.`}
  path="/prazdniki/"
  noindex={!hubIndexable('prazdniki')}
  active="prazdniki"
  ld={ld}
>
  <section class="hero">
    <div class="wrap">
      <Crumbs items={[{ name: 'Главная', href: '/' }, { name: 'Праздники' }]} />
      <h1>Праздники: рейтинги Новосибирска</h1>
      <p class="lead">В разделе – компании, к которым обращаются перед праздником или важной датой. Сейчас здесь один рейтинг, срез на {SREZ}.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap narrow">
      <h2>Рейтинги раздела</h2>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>Рейтинг</th><th>Служб</th><th>Первое место</th><th>Срез</th></tr></thead>
          <tbody><tr><td><a href={u(NICHE.path)}>Доставка цветов</a></td><td>{COMPANIES.length}</td><td>{c1.name}, {dec(c1.ball)}</td><td>{SREZ}</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Как выбирать по задаче</h2>
      <ul class="trust">
        <li><b>Нужен букет ночью или рано утром.</b> В рейтинге отмечены службы, которые работают круглосуточно по данным карт: Русский Букет, Moulen Rose, La Rose (Советская, 55), Amour (Гоголя, 25). <a href={u(NICHE.path + '#luchshie')}>Рейтинг, раздел «Лучшие по задаче»</a></li>
        <li><b>Ограничен бюджет.</b> Самые низкие цены, которые службы показывают на сайте, – в таблице цен рейтинга: букет из 7 роз от 1 880 ₽, роза поштучно – 220 ₽. <a href={u(NICHE.path + '#tseny')}>Рейтинг, раздел «Сколько стоят букет и доставка»</a></li>
        <li><b>Важно, чтобы службу выбирали многие.</b> Больше всего отзывов – у Оверсайз Букет и Русского Букета, у каждого больше 3 500. <a href={u(NICHE.path + '#tablitsa')}>Таблица рейтинга</a></li>
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap narrow">
      <h2>Как мы составляем рейтинги</h2>
      <p>Компанию берём в расчёт, если у неё есть оценки на Яндекс Картах и в 2ГИС. Балл считаем по опубликованной формуле, данные обновляем раз в месяц.</p>
      <a class="link-arrow" href={u('/metodika/')}>Как считаем</a>
    </div>
  </section>
</Base>
