---
// Главная: все рейтинги карточками, чипы категорий («Все» первым – при выборе видны только рейтинги категории), поиск по нише.
// Все цифры – из данных (reytingi.ts, niche.ts).
import Base from '../layouts/Base.astro';
import { NICHES, SUMMARIES, CATEGORIES } from '../lib/reytingi';
import { COMPANIES as TSVETY, TOTAL_REVIEWS as TSVETY_REVIEWS } from '../lib/niche';
import { u, abs } from '../lib/url';
import { int, dec, date, plural } from '../lib/fmt';
import { SITE_NAME, SREZ, SREZ_NEW } from '../lib/site';
import { org, orgId, graph } from '../lib/ld';

const site = Astro.site;
const firms = NICHES.reduce((s, n) => s + n.rows.length, 0) + TSVETY.length;
const reviews = NICHES.reduce((s, n) => s + n.rows.reduce((a, r) => a + r.reviews, 0), 0) + TSVETY_REVIEWS;
const order = CATEGORIES.flatMap((c) => c.niches);
const ld = graph(
  org(site),
  { '@type': 'WebSite', '@id': abs('/', site) + '#site', url: abs('/', site), name: SITE_NAME, inLanguage: 'ru', publisher: { '@id': orgId(site) } },
  { '@type': 'ItemList', name: 'Рейтинги компаний Новосибирска', numberOfItems: SUMMARIES.length, itemListElement: order.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(s.path, site), name: s.name })) },
);
const top = ['zdorove/stomatologii', 'eda/restorany', 'dom/klining', 'prazdniki/dostavka-tsvetov'].map((k) => SUMMARIES.find((s) => s.key === k)).filter(Boolean) as typeof SUMMARIES;
---
<Base
  title={`Рейтинги компаний Новосибирска по отзывам – ${SITE_NAME}`}
  description={`${SUMMARIES.length} ${plural(SUMMARIES.length, ['рейтинг', 'рейтинга', 'рейтингов'])} компаний Новосибирска: еда, здоровье, красота, дом, услуги. Баллы по отзывам Яндекс Карт, формула открыта, места не продаются.`}
  path="/"
  ld={ld}
>
  <section class="hero">
    <div class="wrap">
      <h1>Лучшие компании Новосибирска – рейтинги по отзывам</h1>
      <p class="lead">{SITE_NAME} сравнивает компании Новосибирска по оценкам и отзывам на Яндекс Картах: сколько их, насколько свежие и насколько открыта карточка. Формула опубликована, купить место нельзя.</p>
      <ul class="facts">
        <li>{SUMMARIES.length} {plural(SUMMARIES.length, ['рейтинг', 'рейтинга', 'рейтингов'])} в {CATEGORIES.length} разделах</li>
        <li>{int(firms)} {plural(firms, ['компания', 'компании', 'компаний'])}, {int(reviews)} отзывов</li>
        <li>Срез {SREZ_NEW}, доставка цветов – {SREZ}</li>
      </ul>
      <p class="muted">Популярное: {top.map((s, i) => <>{i > 0 && ' · '}<a href={u(s.path)}>{s.name}</a></>)}</p>
      <a class="btn" href="#reytingi">К рейтингам</a>
    </div>
  </section>

  <section class="section section--alt" id="reytingi">
    <div class="wrap">
      <h2>Все рейтинги</h2>
      <div class="home-tools">
        <label for="q" class="sr-only">Поиск по рейтингам</label>
        <input id="q" class="search" type="search" placeholder="Найти рейтинг: стоматология, суши, клининг…" autocomplete="off" />
        <div class="chips" role="group" aria-label="Разделы">
          <button type="button" class="chip" data-cat="" aria-pressed="true">Все</button>
          {CATEGORIES.map((c) => <button type="button" class="chip" data-cat={c.slug} aria-pressed="false">{c.name}</button>)}
        </div>
      </div>
      <div class="rgrid" id="rgrid">
        {order.map((s) => (
          <a class="rcard" href={u(s.path)} data-cat={s.cat} data-q={`${s.name} ${s.catName} ${s.short}`.toLowerCase()}>
            <span class="rcard__k">{s.catName}</span>
            <span class="rcard__t">{s.name}</span>
            <span class="rcard__one">№1 – <b>{s.first}</b>, {dec(s.firstBall)} из 10</span>
            <span class="rcard__m">{s.count} {plural(s.count, ['компания', 'компании', 'компаний'])} · срез {date(s.srez)}</span>
          </a>
        ))}
      </div>
      <p class="note" id="nothing" hidden>Такого рейтинга пока нет. Предложите нишу через форму «<a href={u('/dobavit-kompaniyu/')}>Предложить компанию</a>».</p>
      <p class="muted" style="margin-top:14px">Разделы: {CATEGORIES.map((c, i) => <>{i > 0 && ' · '}<a href={u(`/${c.slug}/`)}>{c.name}</a></>)}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2>Как мы считаем места</h2>
      <p>Балл из 10 собирают четыре показателя: оценка на Яндекс Картах, сколько у компании отзывов, как давно и как часто их оставляют и насколько полная карточка – сайт, часы, подтверждение владельца, отметка «Хорошее место». В рейтинг попадают профильные компании с оценкой от 4,0 и от 10 отзывов.</p>
      <a class="link-arrow" href={u('/metodika/')}>Методика</a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <h2>Почему рейтингу можно верить</h2>
      <ul class="trust">
        <li>Рядом с каждой оценкой – источник и дата среза. Откройте карточку на Яндекс Картах и сверьте.</li>
        <li>Формула опубликована, по ней можно пересчитать любой балл.</li>
        <li>За место не платят. На страницах рейтингов нет рекламы.</li>
        <li>Слабые места компании пишем в её карточке: мало новых отзывов, нет сайта, карточку не подтвердил владелец.</li>
      </ul>
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap narrow">
      <h2>Вашей компании нет в рейтинге?</h2>
      <p>Отправьте название и ссылку на Яндекс Карты. Проверим данные и посчитаем балл. Бесплатно.</p>
      <a class="btn" href={u('/dobavit-kompaniyu/')}>Предложить компанию</a>
    </div>
  </section>
</Base>
<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chips .chip')];
  const cards = [...document.querySelectorAll<HTMLElement>('#rgrid .rcard')];
  const none = document.getElementById('nothing')!;
  let cat = '';
  const apply = () => {
    const s0 = q.value.trim().toLowerCase().replace(/ё/g, 'е');
    const s = s0.length > 5 ? s0.slice(0, -2) : s0; // «стоматология» находит «стоматологии»
    let n = 0;
    for (const c of cards) {
      const ok = (!cat || c.dataset.cat === cat) && (!s || (c.dataset.q || '').replace(/ё/g, 'е').includes(s));
      c.hidden = !ok;
      if (ok) n++;
    }
    none.hidden = n > 0;
  };
  chips.forEach((b) => b.addEventListener('click', () => {
    cat = b.dataset.cat || '';
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    apply();
  }));
  q.addEventListener('input', apply);
</script>
