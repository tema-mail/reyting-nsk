---
// 404: нет страницы + категории. noindex.
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import { SITE_NAME } from '../lib/site';
import { CATEGORIES } from '../lib/reytingi';
---
<Base title={`Страница не найдена – ${SITE_NAME}`} path="/404/" noindex noCanonical>
  <section class="err-hero">
    <div class="wrap narrow">
      <div class="err-hero__n">404</div>
      <h1>Такой страницы нет</h1>
      <p class="lead">Возможно, адрес набран с ошибкой или рейтинг ещё не опубликован. Вот что есть сейчас:</p>
      <ul class="rest">
        {CATEGORIES.map((c) => <li><a href={u(`/${c.slug}/`)}>{c.name}</a> – {c.niches.map((n) => n.name.toLowerCase()).join(', ')}</li>)}
        <li><a href={u('/metodika/')}>Как считаем места</a></li>
      </ul>
      <p style="margin-top:20px"><a class="btn" href={u('/')}>На главную</a></p>
    </div>
  </section>
</Base>
