---
// Карточка службы доставки цветов (данные Я+2ГИС), /kompanii/<slug>/. Для №1 – тексты дословно из teksty-nsk.md (раздел 4); для остальных – факты среза по шаблону.
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Tbc from '../components/Tbc.astro';
import { COMPANIES, NICHE, tel, type Company } from '../lib/niche';
import { breakdown, whyPlace, strengths, attention, openingHours, similar } from '../lib/kartochka';
import { u, abs } from '../lib/url';
import { int, rate, dec, date, plural } from '../lib/fmt';
import { SREZ, SREZ_ISO } from '../lib/site';
import { org, orgId, crumbs, graph } from '../lib/ld';

interface Props { c: Company }
const { c } = Astro.props;
const site = Astro.site;
const r = c.raw;
const y = r['яндекс'];
const g = r['2гис'];
const path = `/kompanii/${c.slug}/`;
const isFirst = c.place === 1;
const nf = { rel: 'nofollow noopener', target: '_blank' };
const rubrika = String(r.рубрики).split(';')[0].trim();
const sub = `${rubrika.toLowerCase()} в Новосибирске, ${r.адреса.join('; ')}`;

const gisPart = y.рейтинг === g.рейтинг ? `и в 2ГИС (${int(g.отзывов)})` : `${rate(g.рейтинг)} в 2ГИС (${int(g.отзывов)})`;
const description = `${c.place}-е место в рейтинге доставки цветов Новосибирска – ${dec(c.ball)} из 10. ${c.name}: ${rate(y.рейтинг)} на Яндекс Картах (${int(y.текстовых_отзывов)} отзывов) ${gisPart}. На ${SREZ}.`;

// №1 – дословно из текстов карточки; остальные – по данным
const strong = isFirst
  ? ['Больше всего отзывов в рейтинге: 775 на Яндексе и 3 207 в 2ГИС.', '5,0 на обеих картах.', 'Отметка Яндекса «Хорошее место 2026», карточку подтвердил владелец.', 'Работает ежедневно до 23:00.']
  : strengths(c);
const att = isFirst
  ? ['Последний отзыв на Яндексе – 16.08.2026, у соседей по рейтингу отзывы свежее.', 'Цены на главной начинаются с 5 990 ₽; недорогих букетов в срезе нет.', 'Один магазин.']
  : attention(c);
const why = (isFirst ? 'Почему первое место: 3 982 отзыва на двух картах – больше всех в нише, и при этом высшая оценка на обеих. ' : '') + whyPlace(c);
const bd = breakdown(c);
const sim = similar(c);
const pageUrl = abs(path, site);

const ld = graph(
  org(site),
  { '@type': 'WebPage', '@id': pageUrl + '#page', url: pageUrl, name: c.name, inLanguage: 'ru', dateModified: SREZ_ISO, publisher: { '@id': orgId(site) }, about: { '@id': pageUrl + '#company' } },
  {
    '@type': 'Florist',
    '@id': pageUrl + '#company',
    name: c.name,
    address: r.адреса.map((a) => ({ '@type': 'PostalAddress', streetAddress: a, addressLocality: 'Новосибирск', addressCountry: 'RU' })),
    telephone: c.phones,
    url: c.site,
    sameAs: [...c.yaLinks, ...c.gisLinks],
    ...(openingHours(c) ? { openingHoursSpecification: openingHours(c) } : {}),
  },
  crumbs([{ name: 'Главная', path: '/' }, { name: 'Праздники', path: '/prazdniki/' }, { name: 'Доставка цветов', path: NICHE.path }, { name: c.name, path }], site),
);
---
<Base title={`${c.name}, Новосибирск: отзывы и место в рейтинге`} description={description} path={path} active="prazdniki" ld={ld}>
  <section class="hero">
    <div class="wrap">
      <Crumbs items={[{ name: 'Главная', href: '/' }, { name: 'Праздники', href: '/prazdniki/' }, { name: 'Доставка цветов', href: NICHE.path }, { name: c.name }]} />
      <div class="co-hero">
        <div>
          <h1>{c.name}</h1>
          <p class="lead" style="margin-top:-6px">{sub[0].toUpperCase() + sub.slice(1)}</p>
          {c.text.clientOfTeam && <p><Tbc text="пометка о связи с командой (раскрываем ли, что компания – клиент команды)" /></p>}
          <p class="kratko">{c.name} – {c.place}-е место в рейтинге «Доставка цветов» в Новосибирске ({dec(c.ball)}/10), {rate(y.рейтинг)} на Яндекс Картах по {int(y.текстовых_отзывов)} {plural(y.текстовых_отзывов, ['отзыву', 'отзывам', 'отзывам'])}, срез {SREZ}.</p>
          <div class="src-grid">
            <div class="src"><div class="src__k">Яндекс Карты</div><div class="src__v">{rate(y.рейтинг)}</div><div class="src__s">{int(y.оценок)} {plural(y.оценок, ['оценка', 'оценки', 'оценок'])} · {int(y.текстовых_отзывов)} {plural(y.текстовых_отзывов, ['отзыв', 'отзыва', 'отзывов'])}</div></div>
            <div class="src"><div class="src__k">2ГИС</div><div class="src__v">{rate(g.рейтинг)}</div><div class="src__s">{int(g.отзывов)} {plural(g.отзывов, ['отзыв', 'отзыва', 'отзывов'])}</div></div>
            <div class="src"><div class="src__k">Последний отзыв на Яндексе</div><div class="src__v">{date(y.последний_отзыв)}</div><div class="src__s">срез {SREZ}</div></div>
          </div>
          <div class="btns">
            <a class="btn" href={tel(c.phones[0])}>Позвонить</a>
            {c.raw.сайт_работает && <a class="btn btn--ghost" href={c.site} {...nf}>Сайт</a>}
            <a class="btn btn--ghost" href={c.yaLinks[0]} {...nf}>Маршрут</a>
          </div>
        </div>
        <div class="big-score">
          <div class="muted">Балл в рейтинге «Доставка цветов»</div>
          <div class="big-score__n">{dec(c.ball)}<small> / 10</small></div>
          <p style="margin:6px 0 0"><b>{c.place}-е место</b> из {COMPANIES.length}</p>
          <a class="link-arrow" href={u(NICHE.path)}>Весь рейтинг</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap narrow">
      <h2>Место в рейтингах</h2>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>Рейтинг</th><th>Место</th><th>Балл</th></tr></thead>
          <tbody><tr><td><a href={u(NICHE.path)}>Доставка цветов в Новосибирске</a></td><td>{c.place} из {COMPANIES.length}</td><td>{dec(c.ball)}/10</td></tr></tbody>
        </table>
      </div>
      <p style="margin-top:16px">{why}</p>
      <div class="tbl-wrap" style="margin-bottom:12px">
        <table class="tbl">
          <thead><tr><th>Показатель</th><th>Вклад в балл</th></tr></thead>
          <tbody>
            {bd.map((x) => <tr><td>{x.name[0].toUpperCase() + x.name.slice(1)}</td><td>{dec(x.got, 2)} из {dec(x.max, 1)}</td></tr>)}
            <tr><td><b>Итого</b></td><td><b>{dec(c.ballExact, 2)} → {dec(c.ball)}</b></td></tr>
          </tbody>
        </table>
      </div>
      <a class="link-arrow" href={u('/metodika/#dostavka-tsvetov')}>Как устроен балл</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2>Услуги и цены</h2>
      {r.цены_от.length ? (
        <>
          <p>С сайта {c.siteHost} на {SREZ} ({String(r.цены_примечание).split(';')[0]}):</p>
          <div class="tbl-wrap">
            <table class="tbl">
              <thead><tr><th>Позиция</th><th>Цена</th></tr></thead>
              <tbody>
                {r.цены_от.map((p) => {
                  const [pos, ...pr] = p.split(' – ');
                  const cap = pos[0].toUpperCase() + pos.slice(1);
                  return pr.length ? <tr><td>{cap}</td><td>{pr.join(' – ')}</td></tr> : <tr><td colspan="2">{cap}</td></tr>;
                })}
              </tbody>
            </table>
          </div>
        </>
      ) : (
        <p>Цен на сайте в срезе {SREZ} нет: {r.цены_примечание}.</p>
      )}
      <p style="margin-top:14px">Цена доставки и зоны: <Tbc text="цена доставки и зоны" />. Рубрика на Яндекс Картах – «{rubrika}».</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <h2>Сильные стороны и на что обратить внимание</h2>
      <div class="co">
        <div class="co__grid">
          <div>
            <h4>Сильные стороны по данным</h4>
            {strong.length ? <ul>{strong.map((s) => <li>{s}</li>)}</ul> : <p>В срезе нет показателя, по которому служба выделяется среди других.</p>}
          </div>
          <div>
            <h4>Обратите внимание</h4>
            {att.length ? <ul>{att.map((s) => <li>{s}</li>)}</ul> : <p>По данным среза явных слабых мест нет.</p>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2>Отзывы с Яндекс Карт и 2ГИС</h2>
      <p><Tbc text="3–5 отзывов с датой, оценкой и источником, не только пятёрки" /></p>
      <p>
        {c.yaLinks.map((l, i) => <><a href={l} {...nf}>Все отзывы на Яндекс Картах{c.yaLinks.length > 1 ? ` (${r.адреса[i]})` : ''} →</a><br /></>)}
        {c.gisLinks.map((l, i) => <><a href={l} {...nf}>Все отзывы в 2ГИС{c.gisLinks.length > 1 ? ` (${r.адреса[i]})` : ''} →</a><br /></>)}
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap narrow">
      <h2>Адрес и часы работы</h2>
      <p>{c.text.shops}</p>
      <p>Телефон: {c.phones.map((p, i) => <>{i > 0 && '; '}<a href={tel(p)}>{p}</a></>)} · Сайт: <a href={c.site} {...nf}>{c.siteHost}</a>{!r.сайт_работает && ' (не открывается)'}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2>Похожие компании в Новосибирске</h2>
      <ul class="rest">
        {sim.map((x) => (
          <li><a href={u(`/kompanii/${x.slug}/`)}>{x.name}</a> – {x.place}-е место, {dec(x.ball)}{x.hours24 ? ', работает круглосуточно' : ''}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap narrow">
      <h2>Это ваша компания?</h2>
      <p>Устарели цены, часы или телефон – пришлите правку со ссылкой на источник. Проверим и обновим при следующем пересчёте. Балл считает формула, поменять его по просьбе нельзя.</p>
      <a class="btn btn--ghost" href={u('/dobavit-kompaniyu/')}>Исправить данные</a>
    </div>
  </section>
</Base>
