---
// Карточки компаний /kompanii/<slug>/: 12 служб доставки цветов (свой шаблон, данные Я+2ГИС) + компании топ-10 новых ниш (Яндекс Карты).
import KartochkaTsvety from '../../components/KartochkaTsvety.astro';
import KartochkaYa from '../../components/KartochkaYa.astro';
import { COMPANIES } from '../../lib/niche';
import { CARDS } from '../../lib/reytingi';

export function getStaticPaths() {
  return [
    ...COMPANIES.map((c) => ({ params: { slug: c.slug }, props: { kind: 'tsvety', c } })),
    ...CARDS.map((c) => ({ params: { slug: c.slug }, props: { kind: 'ya', c } })),
  ];
}
const { kind, c } = Astro.props as any;
---
{kind === 'tsvety' ? <KartochkaTsvety c={c} /> : <KartochkaYa c={c} />}
